# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional HMAC signing secret for auth sessions (falls back to secure runtime random secret if unset).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional admin bootstrap/override passcode for /admin access.
ADMIN_PASSCODE=

# PAYMENT_GATEWAY_MODE: Set to "test" in development or "live" after configuring a licensed Moroccan PSP (e.g., CMI).
PAYMENT_GATEWAY_MODE="test"
CMI_MERCHANT_ID=
CMI_SECRET_KEY=

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: Optional email notification settings.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
